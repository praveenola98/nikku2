{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile in Nikku Fashion store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "city": { "type": "string" },
        "joinedAt": { "type": "string" },
        "totalOrdersCount": { "type": "number" },
        "totalSpent": { "type": "number" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Apparel item available in store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "gender": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "description": { "type": "string" },
        "inStock": { "type": "boolean" },
        "images": { "type": "array" }
      },
      "required": ["id", "title", "category", "price", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "Order submitted by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "utrNumber": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerEmail", "customerName", "totalAmount", "status", "paymentStatus"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog products added by store owner"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders and tracking status"
    }
  }
}
